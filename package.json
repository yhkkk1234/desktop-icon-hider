{
  "name": "desktop-icon-hider",
  "version": "1.8.4",
  "description": "A desktop icon management tool similar to Fences with simple hide/show functionality",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --enable-logging",
    "build": "powershell -ExecutionPolicy Bypass -File build-native.ps1 && electron-builder",
    "build:win": "powershell -ExecutionPolicy Bypass -File build-native.ps1 && electron-builder --win",
    "rebuild-native": "node-gyp rebuild",
    "postinstall": "node scripts/apply-patches.js",
    "lint": "eslint src/**/*.js",
    "test": "jest"
  },
  "keywords": [
    "desktop",
    "icon-manager",
    "fences",
    "electron"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.2.0",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "electron-auto-launch": "^5.0.7",
    "electron-store": "^8.2.0"
  }
}
