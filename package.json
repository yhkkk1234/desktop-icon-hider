{
  "name": "desktop-icon-hider",
  "version": "1.0.0",
  "description": "A desktop icon management tool similar to Fences with simple hide/show functionality",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --enable-logging",
    "build": "node-gyp rebuild && electron-builder",
    "build:win": "node-gyp rebuild && electron-builder --win",
    "rebuild-native": "node-gyp rebuild",
    "lint": "eslint src/**/*.js",
    "test": "jest"
  },
  "keywords": [
    "desktop",
    "icon-manager",
    "fences",
    "electron"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.2.0",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "electron-auto-launch": "^5.0.7",
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.desktopiconhider.app",
    "productName": "Desktop Icon Hider",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "build/Release/*.node",
      "package.json"
    ],
    "asarUnpack": [
      "build/Release/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
