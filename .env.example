# Environment Configuration

# Application Settings
NODE_ENV=development
APP_NAME=Desktop Icon Hider
APP_VERSION=1.0.0

# Logging
LOG_LEVEL=debug
ENABLE_LOGGING=true

# Window Settings
WINDOW_TRANSPARENCY=true
WINDOW_ALWAYS_ON_TOP=true

# API Settings
API_TIMEOUT=5000
MAX_RETRY_ATTEMPTS=3

# Feature Flags
ENABLE_AUTO_LAUNCH=true
ENABLE_SYSTEM_TRAY=false
ENABLE_UPDATES=false

# Development
DEV_PORT=3000
HOT_RELOAD=false

# Build
BUILD_PLATFORM=win
BUILD_ARCH=x64

# Optional: Set to 'true' to enable experimental features
ENABLE_EXPERIMENTAL=false
